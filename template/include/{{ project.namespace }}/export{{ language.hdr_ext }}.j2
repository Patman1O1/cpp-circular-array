{% if project.type == "Static Library" or project.type == "Shared Library" %}
{% if language.name == "C" %}
#ifndef EXPORT_H
#define EXPORT_H

#ifndef {{ project.name|to_screaming_case }}_STATIC_DEFINE
    #include <{{ project.name }}/export_shared.h>
#else
    #include <{{ project.name }}/export_static.h>
#endif // #ifndef {{ project.name|to_screaming_case }}_STATIC_DEFINE

#endif // #ifndef EXPORT_H
{% elif language.name == "C++" %}
#ifndef EXPORT_HPP
#define EXPORT_HPP

#ifndef {{ project.name|to_screaming_case }}_STATIC_DEFINE
    #include <{{ project.name }}/export_shared.hpp>
#else
    #include <{{ project.name }}/export_static.hpp>
#endif // #ifndef {{ project.name|to_screaming_case }}_STATIC_DEFINE

#endif // #ifndef EXPORT_HPP
{% endif  %}
{% endif  %}